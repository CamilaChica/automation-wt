{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "env": {
        "WT_ENV": "development",
        "WT_AUTH_ENV": "development",
        "WT_AUTH_SECRET": "local-development-only-change-this-secret",
        "EMAIL_SEND_ENABLED": "false",
        "AZURE_TENANT_ID": "",
        "AZURE_CLIENT_ID": "",
        "AZURE_CLIENT_SECRET": "",
        "SALES_EMAIL_USERNAME": "",
        "SALES_EMAIL_PASSWORD": "",
        "PURCHASING_EMAIL_USERNAME": "",
        "PURCHASING_EMAIL_PASSWORD": "",
        "GRAPH_MAILBOX_USER": "",
        "GRAPH_MAILBOX_USER_SALES": "",
        "GRAPH_MAILBOX_USER_PURCHASING": ""
      },
      "envFile": "${workspaceFolder}/.env.local",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Mailbox Worker",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/worker.py",
      "env": {
        "WT_ENV": "development"
      },
      "envFile": "${workspaceFolder}/.env.local",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Alembic: Upgrade Head",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": ["upgrade", "head"],
      "envFile": "${workspaceFolder}/.env.local",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Run API + Worker Simultaneously",
      "configurations": ["API (Uvicorn)", "Mailbox Worker"],
      "stopAll": true
    }
  ]
}