# Authentication
WT_AUTH_ENV=production
WT_AUTH_SECRET=replace-with-a-long-random-secret
WT_AUTH_STORAGE_BACKEND=postgres

# Outlook shared mailboxes
SALES_EMAIL_USERNAME=sales@wingedtycoons.com
SALES_EMAIL_PASSWORD=replace_with_your_sales_password
PURCHASING_EMAIL_USERNAME=purchasing@wingedtycoons.com
PURCHASING_EMAIL_PASSWORD=replace_with_your_purchasing_password

# Outbound supplier and customer communication
# Keep false for local tests; set true only when mailbox credentials are ready.
EMAIL_SEND_ENABLED=false
# Comma-separated fallback contacts used when a new part has no matching offer.
SUPPLIER_REQUEST_RECIPIENTS=

# Mailbox polling runtime
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
# Required in production for shared OTP request/verification throttling.
REDIS_URL=
# Do not trust arbitrary X-Forwarded-For values; configure only verified proxy IPs at the ASGI server.
FORWARDED_ALLOW_IPS=127.0.0.1
# PostgreSQL configuration. Production does not infer localhost when DNS fails.
# DATABASE_URL_FALLBACK is an explicit alternate target for local/test use only.
DATABASE_URL=
DATABASE_URL_FALLBACK=
DATABASE_PREFLIGHT_ATTEMPTS=5
DATABASE_PREFLIGHT_INITIAL_DELAY_SECONDS=0.5
DATABASE_PREFLIGHT_MAX_DELAY_SECONDS=8
OPERATIONAL_POSTGRES_RUNTIME_ENABLED=false
MAILBOX_POLL_INTERVAL_SECONDS=60
MAILBOX_MAX_AGE_DAYS=7
CUSTOMER_FOLLOWUP_DELAY_MINUTES=30
SUPPLIER_DISCOUNT_MAX_ROUNDS=3
PURCHASE_ORDER_NOTIFICATION_EMAIL=camila@wingedtycoons.com
AFTERSHIP_API_KEY=
AFTERSHIP_BASE_URL=https://api.aftership.com/tracking/2026-07
CARRIER_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:3000
AFTERSHIP_WEBHOOK_PATH=/api/webhooks/carriers/aftership
SQLITE_BACKUP_DIR=backups
SQLITE_BACKUP_INTERVAL_SECONDS=86400
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=winged-tycoons-backups

# Frontend build (set to the deployed API URL when frontend is hosted separately)
VITE_API_BASE_URL=/api
FRONTEND_ORIGIN=http://localhost:3000

# Optional future AI providers (leave blank unless you are enabling model-based parsing)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
